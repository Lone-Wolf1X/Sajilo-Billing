# ==============================================
# SAISA Production Environment
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ==============================================

# Database
DB_URL=jdbc:postgresql://localhost:5432/saisa_prod
DB_USERNAME=saisa_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=saisa_prod
DB_HOST=localhost
DB_PORT=5432

# JWT - Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Heap
HEAP_MB=1024

# Logging
LOG_DIR=/var/log/saisa

# Backup
BACKUP_DIR=/opt/saisa-accounting/backups
RETENTION_DAYS=30

